{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SGCLI native v2 creation specification",
  "$comment": "Structural producer contract. Passing this schema is necessary but not sufficient: reference integrity, native capabilities, configured ports, dependencies and semantic equivalence require separate validation. See docs/sgcli-native-v2-spec.md.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "sgcli.native.v2"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "graph_kind": {
      "enum": [
        "main",
        "subgraph"
      ]
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "graph_settings": {
      "$ref": "#/$defs/graph_settings"
    },
    "properties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/property"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      },
      "minItems": 1
    },
    "keywords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/keyword"
      }
    },
    "dropdowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dropdown"
      }
    },
    "loops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/loop"
      }
    },
    "interpolators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interpolator"
      }
    }
  },
  "required": [
    "schema",
    "name",
    "nodes",
    "connections"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "graph_kind": {
            "const": "subgraph"
          }
        },
        "required": [
          "graph_kind"
        ]
      },
      "then": {
        "required": [
          "outputs"
        ],
        "not": {
          "required": [
            "target"
          ]
        },
        "properties": {
          "interpolators": {
            "maxItems": 0
          },
          "outputs": {
            "prefixItems": [
              {
                "properties": {
                  "type": {
                    "enum": [
                      "Vector1",
                      "Vector2",
                      "Vector3",
                      "Vector4",
                      "Matrix2",
                      "Matrix3",
                      "Matrix4",
                      "Boolean"
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "outputs"
          ]
        },
        "properties": {
          "dropdowns": {
            "maxItems": 0
          },
          "graph_settings": {
            "properties": {
              "precision": {
                "enum": [
                  "Single",
                  "Half"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "numeric": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "maxItems": 4
        }
      ]
    },
    "gradient": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "Blend",
            "Fixed",
            "PerceptualBlend"
          ]
        },
        "color_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "color": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": [
              "time",
              "color"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 8
        },
        "alpha_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "alpha": {
                "type": "number"
              }
            },
            "required": [
              "time",
              "alpha"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 8
        }
      },
      "required": [
        "color_keys",
        "alpha_keys"
      ],
      "additionalProperties": false
    },
    "matrix": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "minItems": 4,
          "maxItems": 4
        }
      ]
    },
    "input": {
      "anyOf": [
        {
          "$ref": "#/$defs/numeric"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/matrix"
        },
        {
          "type": "object",
          "properties": {
            "asset": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "asset"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "gradient": {
              "$ref": "#/$defs/gradient"
            }
          },
          "required": [
            "gradient"
          ],
          "additionalProperties": false
        }
      ]
    },
    "endpoint": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "connection": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/endpoint"
        },
        "to": {
          "$ref": "#/$defs/endpoint"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][\\w-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "title",
        "nodes"
      ],
      "additionalProperties": false
    },
    "sampler": {
      "type": "object",
      "properties": {
        "filter": {
          "enum": [
            "Linear",
            "Point",
            "Trilinear"
          ]
        },
        "wrap": {
          "enum": [
            "Repeat",
            "Clamp",
            "Mirror",
            "MirrorOnce"
          ]
        },
        "anisotropic": {
          "enum": [
            "None",
            "x2",
            "x4",
            "x8",
            "x16"
          ]
        }
      },
      "required": [
        "filter",
        "wrap"
      ],
      "additionalProperties": false
    },
    "virtualtexture": {
      "type": "object",
      "properties": {
        "procedural": {
          "type": "boolean"
        },
        "declaration": {
          "enum": [
            "UnityPerMaterial",
            "Global"
          ]
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "pattern": "^[A-Za-z_]\\w*$"
              },
              "asset": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "enum": [
                  "Default",
                  "NormalTangentSpace",
                  "NormalObjectSpace"
                ]
              }
            },
            "required": [
              "name",
              "reference",
              "asset"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 4
        }
      },
      "required": [
        "layers"
      ],
      "additionalProperties": false
    },
    "property": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^_[A-Za-z]\\w*$"
        },
        "type": {
          "enum": [
            "float",
            "vector2",
            "vector3",
            "vector4",
            "color",
            "boolean",
            "matrix2",
            "matrix3",
            "matrix4",
            "texture2d",
            "texture3d",
            "texture2darray",
            "cubemap",
            "gradient",
            "sampler",
            "virtualtexture"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "default": {},
        "range": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "hdr": {
          "type": "boolean"
        },
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "exposed": {
          "type": "boolean"
        },
        "settings": {
          "type": "object",
          "$comment": "Names and values require the native property capability catalog."
        }
      },
      "required": [
        "name",
        "type",
        "display_name",
        "default"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "float"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 1,
                    "maxItems": 1
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "vector2"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "vector3"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "vector4"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "color"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "matrix2"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "matrix3"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "matrix4"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "texture2d"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "texture3d"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "texture2darray"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cubemap"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "gradient"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "$ref": "#/$defs/gradient"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sampler"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "$ref": "#/$defs/sampler"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "virtualtexture"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "$ref": "#/$defs/virtualtexture"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "range"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "float"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "hdr"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "color"
              }
            }
          }
        }
      ]
    },
    "function_port": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_]\\w*$"
        },
        "type": {
          "enum": [
            "Vector1",
            "Vector2",
            "Vector3",
            "Vector4",
            "Boolean",
            "Matrix2",
            "Matrix3",
            "Matrix4",
            "Texture2D",
            "Texture2DArray",
            "Texture3D",
            "Cubemap",
            "SamplerState",
            "Gradient",
            "DynamicVector",
            "DynamicMatrix",
            "VirtualTexture",
            "PropertyConnectionState"
          ]
        },
        "direction": {
          "enum": [
            "Input",
            "Output"
          ]
        },
        "stage": {
          "enum": [
            "All",
            "Vertex",
            "Fragment"
          ]
        },
        "bare_resource": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "direction"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "bare_resource"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "enum": [
                  "Texture2D",
                  "Texture2DArray",
                  "Texture3D",
                  "Cubemap",
                  "SamplerState"
                ]
              }
            }
          }
        }
      ]
    },
    "function": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_]\\w*$"
        },
        "source": {
          "enum": [
            "String",
            "File"
          ]
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^(Assets|Packages)/.+\\.(hlsl|cginc|cg)$"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/function_port"
          },
          "minItems": 1,
          "contains": {
            "properties": {
              "direction": {
                "const": "Output"
              }
            },
            "required": [
              "direction"
            ]
          }
        }
      },
      "required": [
        "name",
        "source",
        "ports"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "String"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "body"
            ],
            "not": {
              "required": [
                "file"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "File"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "file"
            ],
            "not": {
              "required": [
                "body"
              ]
            }
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_]\\w*$"
        },
        "type": {
          "enum": [
            "Vector1",
            "Vector2",
            "Vector3",
            "Vector4",
            "Boolean",
            "Matrix2",
            "Matrix3",
            "Matrix4",
            "Texture2D",
            "Texture2DArray",
            "Texture3D",
            "Cubemap",
            "SamplerState",
            "Gradient",
            "DynamicVector",
            "DynamicMatrix"
          ]
        },
        "stage": {
          "enum": [
            "All",
            "Vertex",
            "Fragment"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][\\w-]*$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "patternProperties": {
            "^-?\\d+$": {
              "$ref": "#/$defs/input"
            }
          },
          "additionalProperties": false
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string"
        },
        "space": {
          "enum": [
            "Object",
            "View",
            "World",
            "Tangent",
            "AbsoluteWorld"
          ]
        },
        "settings": {
          "type": "object",
          "$comment": "Only catalog-declared settings and precision; values checked in Editor."
        },
        "function": {
          "$ref": "#/$defs/function"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "property"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "property"
            ]
          }
        },
        {
          "if": {
